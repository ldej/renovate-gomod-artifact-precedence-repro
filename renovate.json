{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gomod"],
  "includePaths": ["**/go.mod"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "all go modules",
      "groupSlug": "all-go",
      "postUpdateOptions": ["gomodTidyAll"]
    }
  ]
}
